msgstr "Apoie ☕"

#, php-format
msgid ""
"SpamAnvil is 100%% free and always will be. If it's saving you time, "
"consider %s."
msgstr ""
"O SpamAnvil é 100%% gratuito e sempre será. Se está economizando seu tempo, "
"considere %s."

